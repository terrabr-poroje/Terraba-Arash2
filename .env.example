# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudflare D1 Database Configuration
CLOUDFLARE_D1_DATABASE_ID="MY_CLOUDFLARE_D1_DATABASE_ID"
CLOUDFLARE_D1_DATABASE_NAME="terrabar-db"

# sms.ir REST API configuration for OTP & event SMS
SMS_IR_API_KEY="MY_SMS_IR_API_KEY"
SMS_IR_TEMPLATE_ID="MY_SMS_IR_TEMPLATE_ID"
SMS_IR_FALLBACK_TEMPLATE_ID="MY_SMS_IR_FALLBACK_TEMPLATE_ID"
SMS_IR_LINE_NUMBER="MY_SMS_IR_LINE_NUMBER"

# ParsPack S3-Compatible Object Storage
PARSPACK_STORAGE_ENDPOINT="https://YOUR_BUCKET.parspack.net"
PARSPACK_STORAGE_ACCESS_KEY="MY_PARSPACK_ACCESS_KEY"
PARSPACK_STORAGE_SECRET_KEY="MY_PARSPACK_SECRET_KEY"
PARSPACK_STORAGE_BUCKET="MY_PARSPACK_BUCKET"

# Resend Email Service for Email OTP, Password Recovery & Notifications
RESEND_API_KEY="MY_RESEND_API_KEY"
RESEND_FROM_EMAIL="ترابار <auth@terrabar.ir>"

# Admin Bootstrap & Recovery Configuration (set in Cloudflare Variables & Secrets; never commit real secrets)
ADMIN_USERNAME="Rahavard"
ADMIN_DISPLAY_NAME="مدیر کل ترابار"
ADMIN_RECOVERY_EMAIL=""
ADMIN_PHONE_FOR_OTP="09120000000"
ADMIN_DEFAULT_PASSWORD=""

